<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildThisFileDirectory)BepInEx</BepInExDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(BepInExDir)/core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCore)/BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCore)/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCore)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(BepInExDir)/interop/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BepInExDir)/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(BepInExDir)/interop/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(BepInExDir)/interop/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(BepInExDir)/interop/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(BepInExDir)/interop/Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.Cinemachine" HintPath="$(BepInExDir)/interop/Unity.Cinemachine.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(BepInExDir)/interop/UniTask.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(BepInExDir)/interop/Il2Cppmscorlib.dll" Private="false" Aliases="Il2CppTypes" />
  </ItemGroup>
</Project>